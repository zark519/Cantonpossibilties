<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>音樂榜單管理系統 (Music Chart Tracker)</title>
  <style>
    :root {
      --primary-color: #d9534f;
      --bg-color: #f8f9fa;
      --card-bg: #ffffff;
      --border-color: #e0e0e0;
      --text-main: #333333;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    h1, h2, h3 {
      text-align: center;
      margin-bottom: 20px;
    }

    .card {
      background: var(--card-bg);
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 5px;
    }

    input[type="text"], input[type="date"], select {
      width: 100%;
      padding: 10px;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      box-sizing: border-box;
      font-size: 14px;
    }

    .btn {
      background-color: #007bff;
      color: white;
      border: none;
      padding: 10px 18px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      margin-right: 8px;
      margin-bottom: 8px;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .btn-danger { background-color: #dc3545; }
    .btn-success { background-color: #28a745; }
    .btn-secondary { background-color: #6c757d; }

    /* 40周排名輸入表格 */
    .weeks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
      max-height: 400px;
      overflow-y: auto;
      border: 1px solid var(--border-color);
      padding: 10px;
      border-radius: 4px;
      margin-bottom: 15px;
    }

    .week-input-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #f1f3f5;
      padding: 6px 10px;
      border-radius: 4px;
    }

    .week-input-item span {
      font-size: 12px;
      color: #555;
    }

    .week-input-item input {
      width: 60px;
      padding: 4px;
      text-align: center;
    }

    .score-badge {
      font-size: 12px;
      font-weight: bold;
      color: #28a745;
      margin-left: 5px;
    }

    /* 榜單切換按鈕區域 */
    .tab-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .tab-btn {
      padding: 12px 24px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 30px;
      border: 2px solid #007bff;
      background: white;
      color: #007bff;
      cursor: pointer;
    }

    .tab-btn.active {
      background: #007bff;
      color: white;
    }

    /* 榜單 Display */
    .chart-header {
      text-align: center;
      margin-bottom: 15px;
    }

    .chart-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .chart-item {
      display: flex;
      align-items: center;
      padding: 12px 15px;
      border-bottom: 1px solid var(--border-color);
      background: white;
    }

    .chart-item:nth-child(even) {
      background: #fafafa;
    }

    .chart-rank {
      font-size: 20px;
      font-weight: bold;
      width: 45px;
      color: #666;
      text-align: center;
    }

    .chart-info {
      flex-grow: 1;
      padding-left: 15px;
    }

    .song-title {
      color: #dc3545; /* 歌曲名稱為紅色 */
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 3px;
    }

    .artist-name {
      color: #000000; /* 歌手名稱為黑色 */
      font-size: 14px;
    }

    .chart-score {
      font-size: 14px;
      color: #6c757d;
      font-weight: bold;
    }

    /* 歌曲管理列表 */
    .song-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    .song-table th, .song-table td {
      border: 1px solid var(--border-color);
      padding: 8px 12px;
      text-align: left;
    }

    .song-table th {
      background: #e9ecef;
    }

    .file-actions {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-top: 10px;
    }
  </style>
</head>
<body>

<div class="container">
  <h1>🎵 音樂榜單管理系統</h1>

  <!-- 匯入 / 匯出 TXT 區域 -->
  <div class="card">
    <h3>📂 資料備份與匯入/匯出 (TXT 格式)</h3>
    <div class="file-actions">
      <button class="btn btn-success" onclick="exportToTXT()">下載 TXT 資料備份</button>
      <input type="file" id="importFile" accept=".txt" style="display:none;" onchange="importFromTXT(event)">
      <button class="btn btn-secondary" onclick="document.getElementById('importFile').click()">上傳/匯入 TXT 檔案</button>
    </div>
  </div>

  <!-- 新增/編輯歌曲區域 -->
  <div class="card">
    <h3 id="formTitle">➕ 輸入/編輯歌曲資料</h3>
    <form id="songForm">
      <input type="hidden" id="editSongId">
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label for="songTitle">歌曲名稱：</label>
          <input type="text" id="songTitle" required placeholder="例如：海闊天空">
        </div>
        <div class="form-group" style="flex: 1;">
          <label for="artistName">歌手名稱：</label>
          <input type="text" id="artistName" required placeholder="例如：Beyond">
        </div>
        <div class="form-group" style="flex: 1;">
          <label for="entryDate">進榜日期：</label>
          <input type="date" id="entryDate" required onchange="calculateEntryWeek()">
        </div>
      </div>

      <p id="entryWeekNotice" style="color: #007bff; font-weight: bold; margin-top: -5px;"></p>

      <label>輸入連續 40 週排名（可留空自動拉 Curve，輸入 1-50）：</label>
      <div class="weeks-grid" id="weeksInputs">
        <!-- 40 行排名輸入框動態產生 -->
      </div>

      <button type="submit" class="btn btn-primary" id="saveBtn">儲存歌曲榜單</button>
      <button type="button" class="btn btn-secondary" onclick="resetForm()">重置/取消</button>
    </form>
  </div>

  <!-- 榜單展示區域 -->
  <div class="card">
    <div class="tab-buttons">
      <button class="tab-btn active" id="tabWeekly" onclick="switchTab('weekly')">📅 週榜單 (Top 50)</button>
      <button class="tab-btn" id="tabYearly" onclick="switchTab('yearly')">🏆 年榜單</button>
      <button class="tab-btn" id="tabTotal" onclick="switchTab('total')">👑 總累積榜單</button>
    </div>

    <!-- 週榜選擇器 -->
    <div id="weeklySelectorArea" class="form-group" style="max-width: 400px; margin: 0 auto 20px auto;">
      <label for="weekSelect">選擇週數：</label>
      <select id="weekSelect" onchange="renderWeeklyChart()"></select>
    </div>

    <!-- 年榜選擇器 -->
    <div id="yearlySelectorArea" class="form-group" style="max-width: 400px; margin: 0 auto 20px auto; display:none;">
      <label for="yearSelect">選擇年份：</label>
      <select id="yearSelect" onchange="renderYearlyChart()"></select>
    </div>

    <div class="chart-header">
      <h2 id="chartTitle">週榜單 (Top 50)</h2>
      <p id="chartSubTitle" style="color:#666;"></p>
    </div>

    <ul class="chart-list" id="chartDisplay">
      <!-- 榜單匹配內容 -->
    </ul>
  </div>

  <!-- 已登記歌曲列表 -->
  <div class="card">
    <h3>📜 已登記歌曲列表</h3>
    <table class="song-table">
      <thead>
        <tr>
          <th>歌曲</th>
          <th>歌手</th>
          <th>首個進榜週</th>
          <th>在榜週數</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody id="songTableBody">
        <!-- 歌曲列表 -->
      </tbody>
    </table>
  </div>
</div>

<script>
  // 資料存儲
  let songs = JSON.parse(localStorage.getItem('chart_songs') || '[]');
  let currentTab = 'weekly';

  // 初始化
  window.onload = function() {
    init40WeeksInputs();
    updateSongTable();
    updateWeekSelectOptions();
    renderWeeklyChart();
  };

  // 生成 40 行排名輸入框
  function init40WeeksInputs() {
    const container = document.getElementById('weeksInputs');
    container.innerHTML = '';
    for (let i = 1; i <= 40; i++) {
      container.innerHTML += `
        <div class="week-input-item">
          <span>第 ${i} 週:</span>
          <input type="number" min="1" max="50" class="rank-input" data-week="${i}" onchange="updateScorePreview(${i})">
          <span class="score-badge" id="scorePreview_${i}">-</span>
        </div>
      `;
    }
  }

  // 預覽分數：1 = 50, 2 = 49 ... 50 = 1
  function updateScorePreview(weekNum) {
    const input = document.querySelector(`.rank-input[data-week="${weekNum}"]`);
    const badge = document.getElementById(`scorePreview_${weekNum}`);
    const val = parseInt(input.value);
    if (val >= 1 && val <= 50) {
      badge.textContent = `${51 - val}分`;
    } else {
      badge.textContent = '-';
    }
  }

  // 計算星期的函數：固定星期六為最後一天，4日以上歸入該月/年
  function getWeekDetails(dateObj) {
    const date = new Date(dateObj);
    const day = date.getDay(); // 0: Sun, 1: Mon, ... 4: Thu, 5: Fri, 6: Sat

    // 如果日期係星期四或之後 (Thu=4, Fri=5, Sat=6)，進榜星期為下一個星期
    if (day >= 4) {
      date.setDate(date.getDate() + (7 - day + 1)); // 移動到下週一作為計算基準
    }

    // 尋找該星期的星期六（結算日）
    const currentDay = date.getDay();
    const distToSat = (6 - currentDay + 7) % 7;
    const satDate = new Date(date);
    satDate.setDate(date.getDate() + distToSat);

    // 尋找該星期的星期日（起始日）
    const sunDate = new Date(satDate);
    sunDate.setDate(satDate.getDate() - 6);

    // 判斷 4 日以上歸屬月份/年份
    // 計算該星期7天中，哪個月/年份佔了4天以上
    let monthCounts = {};
    let yearCounts = {};
    let tempDate = new Date(sunDate);

    for (let i = 0; i < 7; i++) {
      let y = tempDate.getFullYear();
      let m = tempDate.getMonth() + 1;
      let key = `${y}-${m}`;
      
      monthCounts[key] = (monthCounts[key] || 0) + 1;
      yearCounts[y] = (yearCounts[y] || 0) + 1;

      tempDate.setDate(tempDate.getDate() + 1);
    }

    let targetYear = Object.keys(yearCounts).find(y => yearCounts[y] >= 4) || satDate.getFullYear();
    
    // 計算是該年的第幾週 (以 4 日規則算)
    // 取得該年1月1日
    let jan1 = new Date(targetYear, 0, 1);
    let days = Math.floor((satDate - jan1) / (24 * 60 * 60 * 1000));
    let weekNum = Math.ceil((days + jan1.getDay() + 1) / 7);

    // 日期格式化 MM/DD/YYYY
    const formatDate = (d) => {
      let mm = String(d.getMonth() + 1).padStart(2, '0');
      let dd = String(d.getDate()).padStart(2, '0');
      let yyyy = d.getFullYear();
      return `${mm}/${dd}/${yyyy}`;
    };

    const weekLabel = `${targetYear}年 第${weekNum}週 (${formatDate(sunDate)} - ${formatDate(satDate)})`;
    const weekKey = `${targetYear}_W${String(weekNum).padStart(2, '0')}`;

    return {
      year: parseInt(targetYear),
      weekNum: weekNum,
      weekLabel: weekLabel,
      weekKey: weekKey,
      satDate: satDate
    };
  }

  function calculateEntryWeek() {
    const val = document.getElementById('entryDate').value;
    if (!val) return;
    const weekInfo = getWeekDetails(new Date(val));
    document.getElementById('entryWeekNotice').textContent = `首個進榜星期：${weekInfo.weekLabel}`;
  }

  // 自動拉 Curve (Interpolation) 演算法
  function autoInterpolateRanks(rawRanks) {
    let result = [...rawRanks];
    let filledIndices = [];

    for (let i = 0; i < result.length; i++) {
      if (result[i] !== null && !isNaN(result[i])) {
        filledIndices.push(i);
      }
    }

    if (filledIndices.length < 2) return result; // 少於兩個點無法拉 Curve

    for (let k = 0; k < filledIndices.length - 1; k++) {
      let startIndex = filledIndices[k];
      let endIndex = filledIndices[k + 1];
      let startVal = result[startIndex];
      let endVal = result[endIndex];

      let steps = endIndex - startIndex;
      let diff = endVal - startVal;

      for (let j = 1; j < steps; j++) {
        let interpolatedVal = startVal + (diff / steps) * j;
        let rounded = Math.round(interpolatedVal);
        // 確保限制在 1 - 50
        rounded = Math.max(1, Math.min(50, rounded));
        result[startIndex + j] = rounded;
      }
    }

    return result;
  }

  // 儲存歌曲表單
  document.getElementById('songForm').onsubmit = function(e) {
    e.preventDefault();

    const title = document.getElementById('songTitle').value.trim();
    const artist = document.getElementById('artistName').value.trim();
    const entryDateVal = document.getElementById('entryDate').value;
    const editId = document.getElementById('editSongId').value;

    if (!title || !artist || !entryDateVal) return;

    // 收集輸入的排名
    const inputs = document.querySelectorAll('.rank-input');
    let rawRanks = [];
    inputs.forEach(input => {
      let val = parseInt(input.value);
      rawRanks.push((val >= 1 && val <= 50) ? val : null);
    });

    // 執行拉 Curve 補全中間留空週數
    let finalRanks = autoInterpolateRanks(rawRanks);

    // 計算每週的絕對週次 (Week Key)
    let startWeekInfo = getWeekDetails(new Date(entryDateVal));
    let weeklyData = [];

    let currentSat = new Date(startWeekInfo.satDate);

    for (let i = 0; i < finalRanks.length; i++) {
      if (finalRanks[i] !== null) {
        let rank = finalRanks[i];
        let score = 51 - rank; // 分數計算 1=50, 50=1

        let weekInfo = getWeekDetails(currentSat);

        weeklyData.push({
          weekIndex: i + 1,
          rank: rank,
          score: score,
          weekKey: weekInfo.weekKey,
          weekLabel: weekInfo.weekLabel,
          year: weekInfo.year
        });
      }
      // 前進下一週 Saturday
      currentSat.setDate(currentSat.getDate() + 7);
    }

    const songObj = {
      id: editId ? editId : Date.now().toString(),
      title: title,
      artist: artist,
      entryDate: entryDateVal,
      startWeekKey: startWeekInfo.weekKey,
      startWeekLabel: startWeekInfo.weekLabel,
      weeklyData: weeklyData
    };

    if (editId) {
      songs = songs.map(s => s.id === editId ? songObj : s);
    } else {
      songs.push(songObj);
    }

    saveSongs();
    resetForm();
    updateSongTable();
    updateWeekSelectOptions();
    renderCurrentTab();
  };

  function saveSongs() {
    localStorage.setItem('chart_songs', JSON.stringify(songs));
  }

  function resetForm() {
    document.getElementById('songForm').reset();
    document.getElementById('editSongId').value = '';
    document.getElementById('formTitle').textContent = '➕ 輸入/編輯歌曲資料';
    document.getElementById('saveBtn').textContent = '儲存歌曲榜單';
    document.getElementById('entryWeekNotice').textContent = '';
    init40WeeksInputs();
  }

  function editSong(id) {
    const song = songs.find(s => s.id === id);
    if (!song) return;

    document.getElementById('editSongId').value = song.id;
    document.getElementById('songTitle').value = song.title;
    document.getElementById('artistName').value = song.artist;
    document.getElementById('entryDate').value = song.entryDate;
    document.getElementById('formTitle').textContent = '✏️ 編輯歌曲資料';
    document.getElementById('saveBtn').textContent = '更新歌曲榜單';

    calculateEntryWeek();
    init40WeeksInputs();

    // 填回排名
    song.weeklyData.forEach(w => {
      let idx = w.weekIndex;
      let input = document.querySelector(`.rank-input[data-week="${idx}"]`);
      if (input) {
        input.value = w.rank;
        updateScorePreview(idx);
      }
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function deleteSong(id) {
    if (confirm('確定要刪除這首歌嗎？')) {
      songs = songs.filter(s => s.id !== id);
      saveSongs();
      updateSongTable();
      updateWeekSelectOptions();
      renderCurrentTab();
    }
  }

  // 更新歌曲列表 Display
  function updateSongTable() {
    const tbody = document.getElementById('songTableBody');
    tbody.innerHTML = '';
    songs.forEach(song => {
      tbody.innerHTML += `
        <tr>
          <td><strong style="color:#dc3545;">${song.title}</strong></td>
          <td>${song.artist}</td>
          <td><small>${song.startWeekLabel}</small></td>
          <td>${song.weeklyData.length} 週</td>
          <td>
            <button class="btn btn-secondary" onclick="editSong('${song.id}')">編輯</button>
            <button class="btn btn-danger" onclick="deleteSong('${song.id}')">刪除</button>
          </td>
        </tr>
      `;
    });
  }

  // 選項選單更新 (周數 & 年份)
  function updateWeekSelectOptions() {
    const weekSelect = document.getElementById('weekSelect');
    const yearSelect = document.getElementById('yearSelect');

    let weekMap = new Map();
    let years = new Set();

    songs.forEach(s => {
      s.weeklyData.forEach(w => {
        weekMap.set(w.weekKey, w.weekLabel);
        years.add(w.year);
      });
    });

    // 排序周次
    const sortedWeeks = Array.from(weekMap.keys()).sort().reverse();
    weekSelect.innerHTML = '';
    sortedWeeks.forEach(key => {
      weekSelect.innerHTML += `<option value="${key}">${weekMap.get(key)}</option>`;
    });

    // 排序年份
    const sortedYears = Array.from(years).sort().reverse();
    yearSelect.innerHTML = '';
    sortedYears.forEach(y => {
      yearSelect.innerHTML += `<option value="${y}">${y} 年</option>`;
    });
  }

  // 切換榜單 Tab
  function switchTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

    document.getElementById('weeklySelectorArea').style.display = (tab === 'weekly') ? 'block' : 'none';
    document.getElementById('yearlySelectorArea').style.display = (tab === 'yearly') ? 'block' : 'none';

    if (tab === 'weekly') {
      document.getElementById('tabWeekly').classList.add('active');
      document.getElementById('chartTitle').textContent = '週榜單 (Top 50)';
      renderWeeklyChart();
    } else if (tab === 'yearly') {
      document.getElementById('tabYearly').classList.add('active');
      document.getElementById('chartTitle').textContent = '年度總榜單';
      renderYearlyChart();
    } else if (tab === 'total') {
      document.getElementById('tabTotal').classList.add('active');
      document.getElementById('chartTitle').textContent = '累積總榜單';
      renderTotalChart();
    }
  }

  function renderCurrentTab() {
    switchTab(currentTab);
  }

  // 1. 渲染週榜單 (50 個位置 Matching)
  function renderWeeklyChart() {
    const selectedWeekKey = document.getElementById('weekSelect').value;
    const displayContainer = document.getElementById('chartDisplay');
    displayContainer.innerHTML = '';

    if (!selectedWeekKey) {
      document.getElementById('chartSubTitle').textContent = '暫無週榜資料';
      return;
    }

    const weekText = document.getElementById('weekSelect').options[document.getElementById('weekSelect').selectedIndex]?.text;
    document.getElementById('chartSubTitle').textContent = weekText || '';

    // 建立 1 - 50 位Matching Array
    let rankMap = {};

    songs.forEach(song => {
      let match = song.weeklyData.find(w => w.weekKey === selectedWeekKey);
      if (match && match.rank >= 1 && match.rank <= 50) {
        rankMap[match.rank] = {
          title: song.title,
          artist: song.artist,
          score: match.score
        };
      }
    });

    for (let r = 1; r <= 50; r++) {
      let item = rankMap[r];
      if (item) {
        displayContainer.innerHTML += `
          <li class="chart-item">
            <div class="chart-rank">${r}</div>
            <div class="chart-info">
              <div class="song-title">${item.title}</div>
              <div class="artist-name">${item.artist}</div>
            </div>
            <div class="chart-score">${item.score} 分</div>
          </li>
        `;
      } else {
        displayContainer.innerHTML += `
          <li class="chart-item" style="opacity: 0.4;">
            <div class="chart-rank">${r}</div>
            <div class="chart-info">
              <div class="song-title" style="color:#aaa;">--- 虛位以待 ---</div>
              <div class="artist-name" style="color:#aaa;">---</div>
            </div>
            <div class="chart-score">-</div>
          </li>
        `;
      }
    }
  }

  // 2. 渲染年榜單 (累計年度分數)
  function renderYearlyChart() {
    const selectedYear = parseInt(document.getElementById('yearSelect').value);
    const displayContainer = document.getElementById('chartDisplay');
    displayContainer.innerHTML = '';

    if (!selectedYear) {
      document.getElementById('chartSubTitle').textContent = '暫無年份資料';
      return;
    }

    document.getElementById('chartSubTitle').textContent = `${selectedYear} 年度累計總分數排名`;

    let songScores = [];

    songs.forEach(song => {
      let totalYearScore = 0;
      let weeksInYear = 0;

      song.weeklyData.forEach(w => {
        if (w.year === selectedYear) {
          totalYearScore += w.score;
          weeksInYear++;
        }
      });

      if (totalYearScore > 0) {
        songScores.push({
          title: song.title,
          artist: song.artist,
          score: totalYearScore,
          weeks: weeksInYear
        });
      }
    });

    songScores.sort((a, b) => b.score - a.score);

    if (songScores.length === 0) {
      displayContainer.innerHTML = '<li class="chart-item">該年份暫無數據</li>';
      return;
    }

    songScores.forEach((item, index) => {
      displayContainer.innerHTML += `
        <li class="chart-item">
          <div class="chart-rank">${index + 1}</div>
          <div class="chart-info">
            <div class="song-title">${item.title}</div>
            <div class="artist-name">${item.artist} (${item.weeks} 週在榜)</div>
          </div>
          <div class="chart-score">${item.score} 分</div>
        </li>
      `;
    });
  }

  // 3. 渲染總累積榜單
  function renderTotalChart() {
    const displayContainer = document.getElementById('chartDisplay');
    displayContainer.innerHTML = '';
    document.getElementById('chartSubTitle').textContent = '歷史所有星期總分數累計排名';

    let songScores = [];

    songs.forEach(song => {
      let totalScore = song.weeklyData.reduce((sum, w) => sum + w.score, 0);
      if (totalScore > 0) {
        songScores.push({
          title: song.title,
          artist: song.artist,
          score: totalScore,
          weeks: song.weeklyData.length
        });
      }
    });

    songScores.sort((a, b) => b.score - a.score);

    if (songScores.length === 0) {
      displayContainer.innerHTML = '<li class="chart-item">暫無累積數據</li>';
      return;
    }

    songScores.forEach((item, index) => {
      displayContainer.innerHTML += `
        <li class="chart-item">
          <div class="chart-rank">${index + 1}</div>
          <div class="chart-info">
            <div class="song-title">${item.title}</div>
            <div class="artist-name">${item.artist} (共 ${item.weeks} 週)</div>
          </div>
          <div class="chart-score">${item.score} 分</div>
        </li>
      `;
    });
  }

  // 導出為 TXT 檔案 (人眼可讀 + 包含編碼 Data)
  function exportToTXT() {
    if (songs.length === 0) {
      alert('現時沒有任何歌曲資料可導出！');
      return;
    }

    let txtContent = "=========================================\n";
    txtContent += "       音樂榜單系統資料備份 (TXT)\n";
    txtContent += "=========================================\n\n";

    songs.forEach((s, idx) => {
      txtContent += `${idx + 1}. 歌曲：${s.title} | 歌手：${s.artist}\n`;
      txtContent += `   進榜日期：${s.entryDate} (${s.startWeekLabel})\n`;
      txtContent += `   週排名紀錄：\n`;
      s.weeklyData.forEach(w => {
        txtContent += `     - [第${w.weekIndex}週] ${w.weekLabel} -> 排名:${w.rank} (分數:${w.score})\n`;
      });
      txtContent += "\n";
    });

    txtContent += "=========================================\n";
    txtContent += "系統數據區 (請勿修改以下文字，導入時使用)：\n";
    txtContent += "DATA_START\n";
    txtContent += btoa(encodeURIComponent(JSON.stringify(songs))); // Base64 編碼
    txtContent += "\nDATA_END\n";

    const blob = new Blob([txtContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Chart_Backup_${new Date().toISOString().slice(0,10)}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // 從 TXT 檔案導入資料
  function importFromTXT(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const content = e.target.result;
        const startIndex = content.indexOf("DATA_START\n") + "DATA_START\n".length;
        const endIndex = content.indexOf("\nDATA_END");

        if (startIndex === -1 || endIndex === -1) {
          throw new Error('找不到有效的系統數據標籤！');
        }

        const base64Data = content.substring(startIndex, endIndex).trim();
        const jsonString = decodeURIComponent(atob(base64Data));
        const importedSongs = JSON.parse(jsonString);

        if (Array.isArray(importedSongs)) {
          if (confirm(`成功讀取 TXT 數據！是否覆蓋目前的 ${songs.length} 首歌曲資料？`)) {
            songs = importedSongs;
            saveSongs();
            updateSongTable();
            updateWeekSelectOptions();
            renderCurrentTab();
            alert('資料導入成功！');
          }
        } else {
          throw new Error('數據格式不正確！');
        }
      } catch (err) {
        alert('導入失敗：' + err.message);
      }
      event.target.value = ''; // 清空 input
    };
    reader.readAsText(file);
  }
</script>
